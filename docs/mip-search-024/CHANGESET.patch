index 0000000..8a31cd0
--- /dev/null
+++ b/crates/native/src/cuts.rs
@@ -0,0 +1,254 @@
+//! LP-directed binary knapsack covers with exact bounded sequential lifting.
+use crate::CancellationToken;
+use lp_ip_craft::{Model, Result};
+#[derive(Default)]
+pub(crate) struct Stats {
+    pub added: usize,
+    pub lifted: usize,
+    pub work: usize,
+}
+/// Exact minimum weight for every attainable cut profit. None means effort cap.
+fn max_profit(terms: &[(usize, i128, i64)], capacity: i128, work: &mut usize) -> Option<i64> {
+    if capacity < 0 {
+        return None;
+    }
+    let total: usize = terms.iter().map(|t| t.2 as usize).sum();
+    if total > 8192 {
+        return None;
+    }
+    let mut dp = vec![i128::MAX; total + 1];
+    dp[0] = 0;
+    let mut end = 0;
+    for &(_, w, c) in terms {
+        let c = c as usize;
+        if c == 0 {
+            continue;
+        }
+        for p in (0..=end).rev() {
+            *work += 1;
+            if *work > 2_000_000 {
+                return None;
+            }
+            if dp[p] != i128::MAX {
+                let v = dp[p] + w;
+                if v <= capacity {
+                    dp[p + c] = dp[p + c].min(v);
+                }
+            }
+        }
+        end += c;
+    }
+    (0..dp.len())
+        .rev()
+        .find(|&p| dp[p] <= capacity)
+        .map(|p| p as i64)
+}
+pub(crate) fn separate(
+    model: &mut Model,
+    x: &[f64],
+    lifting: bool,
+    cancel: &CancellationToken,
+) -> Result<Stats> {
+    let mut stats = Stats::default();
+    let a = model.matrix();
+    let mut output: Vec<(Vec<(usize, i64)>, i64)> = Vec::new();
+    let mut seen = std::collections::BTreeSet::new();
+    for i in 0..model.m() {
+        if cancel.is_cancelled() || stats.work > 2_000_000 || output.len() >= 8 {
+            break;
+        }
+        let b = model.rows().upper[i];
+        let r = a.pattern.indptr[i]..a.pattern.indptr[i + 1];
+        if !(3..=128).contains(&r.len()) || !b.is_finite() || !(0. ..=2_147_483_647.).contains(&b) {
+            continue;
+        }
+        let mut weights = Vec::new();
+        let mut valid = true;
+        for k in r {
+            let (j, v) = (a.pattern.indices[k], a.values[k]);
+            if v == 0. {
+                continue;
+            }
+            if !model.kinds()[j].is_integral()
+                || model.variables().lower[j] < 0.
+                || model.variables().upper[j] > 1.
+                || v.fract() != 0.
+                || !(1. ..=2_147_483_647.).contains(&v)
+            {
+                valid = false;
+                break;
+            }
+            weights.push((j, v as i128));
+        }
+        if !valid {
+            continue;
+        }
+        let capacity = b.floor() as i128;
+        for order in 0..2 {
+            let mut sorted = weights.clone();
+            sorted.sort_by(|&(j, w), &(k, v)| {
+                if order == 0 {
+                    x[k].total_cmp(&x[j]).then(j.cmp(&k))
+                } else {
+                    ((1. - x[j]) / w as f64)
+                        .total_cmp(&((1. - x[k]) / v as f64))
+                        .then(j.cmp(&k))
+                }
+            });
+            let mut sum = 0;
+            let mut cover = Vec::new();
+            for pair in sorted {
+                sum += pair.1;
+                cover.push(pair);
+                if sum > capacity {
+                    break;
+                }
+            }
+            if sum <= capacity {
+                continue;
+            }
+            for p in (0..cover.len()).rev() {
+                if sum - cover[p].1 > capacity {
+                    sum -= cover.remove(p).1;
+                }
+            }
+            if cover.len() < 2 {
+                continue;
+            }
+            let rhs = (cover.len() - 1) as i64;
+            let mut terms: Vec<_> = cover.iter().map(|&(j, w)| (j, w, 1i64)).collect();
+            if lifting {
+                let mut outside: Vec<_> = weights
+                    .iter()
+                    .copied()
+                    .filter(|(j, _)| !cover.iter().any(|t| t.0 == *j))
+                    .collect();
+                outside.sort_by(|a, b| x[b.0].total_cmp(&x[a.0]).then(a.0.cmp(&b.0)));
+                for (j, w) in outside {
+                    if cancel.is_cancelled() {
+                        break;
+                    }
+                    if let Some(max) = max_profit(&terms, capacity - w, &mut stats.work) {
+                        let alpha = (rhs - max).max(0);
+                        if alpha > 0 {
+                            terms.push((j, w, alpha));
+                        }
+                    } else {
+                        break;
+                    }
+                }
+            }
+            // Independent final exact knapsack validation. Unlifted cover proof also checked.
+            if max_profit(&terms, capacity, &mut stats.work).is_none_or(|v| v > rhs) {
+                continue;
+            }
+            let mut cut: Vec<_> = terms.iter().map(|&(j, _, c)| (j, c)).collect();
+            cut.sort_unstable();
+            let activity: f64 = cut.iter().map(|&(j, c)| x[j] * c as f64).sum();
+            if activity <= rhs as f64 + 1e-7 {
+                continue;
+            }
+            let duplicate = (0..model.m()).any(|row| {
+                let r = a.pattern.indptr[row]..a.pattern.indptr[row + 1];
+                model.rows().upper[row] == rhs as f64
+                    && r.len() == cut.len()
+                    && r.zip(&cut)
+                        .all(|(k, &(j, c))| a.pattern.indices[k] == j && a.values[k] == c as f64)
+            });
+            if duplicate || !seen.insert(cut.clone()) {
+                continue;
+            }
+            stats.lifted += usize::from(terms.len() > cover.len());
+            output.push((cut, rhs));
+            if output.len() >= 8 {
+                break;
+            }
+        }
+    }
+    if !output.is_empty() {
+        let mut data = model.data().clone();
+        for (cut, rhs) in &output {
+            for &(j, c) in cut {
+                data.matrix.pattern.indices.push(j);
+                data.matrix.values.push(c as f64);
+            }
+            data.matrix.pattern.indptr.push(data.matrix.values.len());
+            data.matrix.pattern.rows += 1;
+            data.rows.lower.push(f64::NEG_INFINITY);
+            data.rows.upper.push(*rhs as f64);
+        }
+        stats.added = output.len();
+        *model = Model::new(data)?;
+    }
+    Ok(stats)
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use lp_ip_craft::*;
+    #[test]
+    fn directed_lifted_cover_is_violated_and_exhaustively_valid() {
+        let mut m = Model::new(ModelData {
+            sense: Sense::Maximize,
+            objective: vec![1.; 4],
+            objective_offset: 0.,
+            variables: Bounds::new(vec![0.; 4], vec![1.; 4]),
+            kinds: vec![VariableKind::Binary; 4],
+            matrix: CsrMatrix::from_dense(1, 4, &[3., 3., 3., 4.]).unwrap(),
+            rows: Bounds::new(vec![f64::NEG_INFINITY], vec![5.]),
+        })
+        .unwrap();
+        let original = m.clone();
+        let stats = separate(
+            &mut m,
+            &[0.55, 0.55, 0.55, 0.],
+            true,
+            &CancellationToken::default(),
+        )
+        .unwrap();
+        assert!(stats.added > 0 && stats.lifted > 0);
+        for mask in 0..16 {
+            let x: Vec<_> = (0..4).map(|j| ((mask >> j) & 1) as f64).collect();
+            if check::evaluate(&original, &x, &Tolerances::default())
+                .unwrap()
+                .feasible_candidate
+            {
+                assert!(
+                    check::evaluate(&m, &x, &Tolerances::default())
+                        .unwrap()
+                        .feasible_candidate
+                );
+            }
+        }
+    }
+    #[test]
+    fn exact_profit_matches_enumeration() {
+        let mut seed = 3u64;
+        for n in 2..10 {
+            for _ in 0..30 {
+                let mut terms = Vec::new();
+                for j in 0..n {
+                    seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1);
+                    terms.push((
+                        j,
+                        ((seed >> 33) % 13 + 1) as i128,
+                        ((seed >> 28) % 5 + 1) as i64,
+                    ));
+                }
+                let cap = 20;
+                let exact = (0..1usize << n)
+                    .filter_map(|mask| {
+                        let (w, p) = terms
+                            .iter()
+                            .enumerate()
+                            .filter(|(j, _)| (mask >> j) & 1 != 0)
+                            .fold((0, 0), |(w, p), (_, t)| (w + t.1, p + t.2));
+                        (w <= cap).then_some(p)
+                    })
+                    .max()
+                    .unwrap();
+                assert_eq!(max_profit(&terms, cap, &mut 0), Some(exact));
+            }
+        }
+    }
+}
diff --git a/crates/native/src/jump.rs b/crates/native/src/jump.rs
new file mode 100644
index 0000000..f0f9748
--- /dev/null
+++ b/crates/native/src/jump.rs
@@ -0,0 +1,222 @@
+//! Bounded deterministic Feasibility Jump prototype. Scores are heuristic only.
+use crate::Budget;
+use lp_ip_craft::{Bounds, Model};
+#[derive(Default)]
+pub(crate) struct Stats {
+    pub steps: u64,
+    pub work: u64,
+    pub feasible: u64,
+    pub bumps: u64,
+}
+fn violation(v: f64, l: f64, u: f64) -> f64 {
+    (l - v).max(v - u).max(0.)
+}
+pub(crate) fn search(
+    model: &Model,
+    bounds: &Bounds,
+    seed: &[f64],
+    budget: &Budget<'_>,
+    limit: u64,
+) -> (Option<Vec<f64>>, Stats) {
+    let mut stats = Stats::default();
+    let n = model.n();
+    let m = model.m();
+    let a = model.matrix();
+    let mut incident = vec![Vec::new(); n];
+    for i in 0..m {
+        for k in a.pattern.indptr[i]..a.pattern.indptr[i + 1] {
+            let j = a.pattern.indices[k];
+            if a.values[k] != 0. {
+                incident[j].push((i, a.values[k]));
+            }
+        }
+    }
+    let initial = |j: usize| {
+        let v = if model.kinds()[j].is_integral() {
+            seed[j].round()
+        } else {
+            seed[j]
+        };
+        v.max(bounds.lower[j]).min(bounds.upper[j])
+    };
+    let mut x: Vec<f64> = (0..n).map(initial).collect();
+    let mut lhs = vec![0.; m];
+    a.multiply(&x, &mut lhs);
+    let mut weight = vec![1.; m];
+    let mut dirty = vec![true; n];
+    let mut jumps = x.clone();
+    let mut scores = vec![f64::NEG_INFINITY; n];
+    let mut stall = 0usize;
+    let cap = limit.saturating_mul(512).min(10_000_000);
+    for step in 0..limit {
+        if budget.stop().is_some() || stats.work >= cap {
+            break;
+        }
+        if step % 32 == 0 {
+            a.multiply(&x, &mut lhs);
+            dirty.fill(true);
+        }
+        if (0..m).all(|i| violation(lhs[i], model.rows().lower[i], model.rows().upper[i]) <= 1e-10)
+        {
+            stats.feasible += 1;
+            return (Some(x), stats);
+        }
+        for j in 0..n {
+            if !dirty[j] {
+                continue;
+            }
+            dirty[j] = false;
+            let old = x[j];
+            let mut candidates = vec![old, bounds.lower[j], bounds.upper[j]];
+            for &(i, c) in &incident[j] {
+                for b in [model.rows().lower[i], model.rows().upper[i]] {
+                    if b.is_finite() {
+                        let v = old + (b - lhs[i]) / c;
+                        if model.kinds()[j].is_integral() {
+                            candidates.push(v.floor());
+                            candidates.push(v.ceil());
+                        } else {
+                            candidates.push(v);
+                        }
+                    }
+                }
+            }
+            let mut best = (f64::NEG_INFINITY, old);
+            for v in candidates {
+                let v = v.max(bounds.lower[j]).min(bounds.upper[j]);
+                if !v.is_finite() || v == old {
+                    continue;
+                }
+                let mut score = 0.;
+                for &(i, c) in &incident[j] {
+                    stats.work += 1;
+                    score += weight[i]
+                        * (violation(lhs[i], model.rows().lower[i], model.rows().upper[i])
+                            - violation(
+                                lhs[i] + c * (v - old),
+                                model.rows().lower[i],
+                                model.rows().upper[i],
+                            ));
+                    if stats.work >= cap {
+                        break;
+                    }
+                }
+                if stats.work >= cap {
+                    break;
+                }
+                if score > best.0 {
+                    best = (score, v);
+                }
+            }
+            scores[j] = best.0;
+            jumps[j] = best.1;
+            if stats.work >= cap || budget.stop().is_some() {
+                break;
+            }
+        }
+        if stats.work >= cap || budget.stop().is_some() {
+            break;
+        }
+        let mut chosen = (0..n)
+            .filter(|&j| jumps[j] != x[j])
+            .max_by(|&j, &k| scores[j].total_cmp(&scores[k]).then(k.cmp(&j)));
+        if chosen.is_none_or(|j| scores[j] <= 1e-10) {
+            stats.bumps += 1;
+            stall += 1;
+            let violated: Vec<_> = (0..m)
+                .filter(|&i| {
+                    violation(lhs[i], model.rows().lower[i], model.rows().upper[i]) > 1e-10
+                })
+                .collect();
+            for &i in &violated {
+                weight[i] = (weight[i] + 1.).min(1e6);
+                for k in a.pattern.indptr[i]..a.pattern.indptr[i + 1] {
+                    dirty[a.pattern.indices[k]] = true;
+                }
+            }
+            if violated.is_empty() {
+                break;
+            }
+            let row = violated[(stall - 1) % violated.len()];
+            chosen = (a.pattern.indptr[row]..a.pattern.indptr[row + 1])
+                .map(|k| a.pattern.indices[k])
+                .filter(|&j| jumps[j] != x[j])
+                .max_by(|&j, &k| scores[j].total_cmp(&scores[k]).then(k.cmp(&j)));
+            // A deterministic restart explores a different corner while keeping fixed columns.
+            if stall % 32 == 0 {
+                for (j, value) in x.iter_mut().enumerate() {
+                    let v = if (j + stall / 32) % 3 == 0 {
+                        bounds.upper[j]
+                    } else {
+                        bounds.lower[j]
+                    };
+                    *value = if v.is_finite() {
+                        if model.kinds()[j].is_integral() {
+                            v.round()
+                        } else {
+                            v
+                        }
+                    } else {
+                        initial(j)
+                    };
+                }
+                a.multiply(&x, &mut lhs);
+                dirty.fill(true);
+                continue;
+            }
+        }
+        let Some(j) = chosen else {
+            dirty.fill(true);
+            continue;
+        };
+        let delta = jumps[j] - x[j];
+        x[j] = jumps[j];
+        for &(i, c) in &incident[j] {
+            lhs[i] += c * delta;
+            for k in a.pattern.indptr[i]..a.pattern.indptr[i + 1] {
+                dirty[a.pattern.indices[k]] = true;
+            }
+        }
+        dirty[j] = true;
+        stats.steps += 1;
+    }
+    (None, stats)
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::NativeOptions;
+    use lp_ip_craft::*;
+    #[test]
+    fn repairs_rounding_with_sparse_jumps() {
+        let m = Model::new(ModelData {
+            sense: Sense::Minimize,
+            objective: vec![0.; 3],
+            objective_offset: 0.,
+            variables: Bounds::new(vec![0.; 3], vec![1.; 3]),
+            kinds: vec![VariableKind::Binary; 3],
+            matrix: CsrMatrix::from_dense(1, 3, &[1., 1., 1.]).unwrap(),
+            rows: Bounds::fixed(vec![1.]),
+        })
+        .unwrap();
+        let s = NativeOptions::default();
+        let c = CancellationToken::default();
+        let b = Budget {
+            start: std::time::Instant::now(),
+            settings: &s,
+            cancel: &c,
+            pivots: 0,
+        };
+        let (x, t) = search(&m, m.variables(), &[0.4; 3], &b, 100);
+        assert!(
+            check::evaluate(&m, &x.unwrap(), &Tolerances::default())
+                .unwrap()
+                .feasible_candidate
+        );
+        assert!(t.steps > 0 && t.work <= 51200);
+        let (x, t) = search(&m, m.variables(), &[0.4; 3], &b, 0);
+        assert!(x.is_none() && t.steps == 0);
+        c.cancel();
+        assert!(search(&m, m.variables(), &[0.4; 3], &b, 100).0.is_none());
+    }
+}
