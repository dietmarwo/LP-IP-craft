+inputs = root / "docs/performance-ten/data/oracle-inputs.json"
+policies = [("default", []), ("ft", ["--variant", "ft"]), ("no-fix", ["--no-fixing"]),
+            ("refactor1", ["--variant", "refactor1", "--suite", "exact"]),
