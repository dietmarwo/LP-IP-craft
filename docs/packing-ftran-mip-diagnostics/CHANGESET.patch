+                .map(|j| {
+                    if step % 4 == 0 {
+                        0.
+                    } else if step % 4 == 1 {
+                        (j % 7) as f64 - 3.
+                    } else if j == step || j == step + 1 {
+                        1.
+                    } else {
+                        0.
+                    }
