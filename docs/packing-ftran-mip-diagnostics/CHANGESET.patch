+import sys
+from pathlib import Path
+
+p = argparse.ArgumentParser()
+p.add_argument("--output", type=Path)
+a = p.parse_args()
+root = Path(__file__).resolve().parent.parent
+out = a.output or root / "docs/packing-ftran-mip-diagnostics/data"
