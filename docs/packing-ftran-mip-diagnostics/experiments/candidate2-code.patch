+                    alpha[i] = a;
+                }
+                lu.ftran_entering_indexed(&mut alpha, &mut indices);
+                if step == 8 {
+                    lu.force_refactor = true;
+                }
+                let accepted = lu.update_sparse(p, &alpha, indices.iter().copied());
+                assert_eq!(accepted, step == 4);
+                columns[p] = new;
+            }
+        }
+        assert!(!lu.etas.is_empty());
