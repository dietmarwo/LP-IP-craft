+/// Imports immutable model slices directly, avoiding the RowProblem builder's
+/// per-column allocations and extra floating-point copies. The caller applies
+/// `small_matrix_value` before import and checks backend numeric limits.
+pub fn load(native: &mut highs::Model, model: &Model) -> Result<()> {
+    let index = |value: usize| {
+        HighsInt::try_from(value)
+            .map_err(|_| Error::Unsupported("model exceeds HiGHS's index range".into()))
+    };
+    let (n, m, nnz) = (index(model.n())?, index(model.m())?, index(model.nnz())?);
+    let a = model.matrix();
+    let starts = a
+        .pattern
+        .indptr
+        .iter()
+        .map(|&i| index(i))
+        .collect::<Result<Vec<_>>>()?;
+    let indices = a
+        .pattern
+        .indices
+        .iter()
+        .map(|&i| index(i))
+        .collect::<Result<Vec<_>>>()?;
+    let sense = match model.sense() {
+        Sense::Minimize => kHighsObjSenseMinimize,
+        Sense::Maximize => kHighsObjSenseMaximize,
+    };
+    let integrality = model.is_mip().then(|| {
+        model
+            .kinds()
+            .iter()
+            .map(|kind| {
+                if kind.is_integral() {
+                    kHighsVarTypeInteger
+                } else {
+                    kHighsVarTypeContinuous
+                }
+            })
+            .collect::<Vec<_>>()
+    });
+    // SAFETY: the uniquely borrowed handle is owned by highs::Model. Model's
+    // constructor guarantees CSR shape, sorted valid indices, and all vector
+    // lengths. Every usize -> HighsInt conversion is checked above. All buffers
+    // remain live for this synchronous call. HiGHS 1.15.0 passModel copies costs,
+    // bounds, indices, values and integrality; it retains none of these pointers.
+    // Empty slices are not dereferenced when their corresponding count is zero.
+    let code = unsafe {
+        if let Some(kinds) = &integrality {
+            Highs_passMip(
+                native.as_mut_ptr(),
+                n,
+                m,
+                nnz,
+                kHighsMatrixFormatRowwise,
+                sense,
+                model.objective_offset(),
+                model.objective().as_ptr(),
+                model.variables().lower.as_ptr(),
+                model.variables().upper.as_ptr(),
+                model.rows().lower.as_ptr(),
+                model.rows().upper.as_ptr(),
+                starts.as_ptr(),
+                indices.as_ptr(),
+                a.values.as_ptr(),
+                kinds.as_ptr(),
+            )
+        } else {
+            Highs_passLp(
+                native.as_mut_ptr(),
+                n,
+                m,
+                nnz,
+                kHighsMatrixFormatRowwise,
+                sense,
+                model.objective_offset(),
+                model.objective().as_ptr(),
+                model.variables().lower.as_ptr(),
+                model.variables().upper.as_ptr(),
+                model.rows().lower.as_ptr(),
+                model.rows().upper.as_ptr(),
+                starts.as_ptr(),
+                indices.as_ptr(),
+                a.values.as_ptr(),
+            )
+        }
+    };
+    // As in highs::Model::try_new, legal imports may warn (e.g. explicit zeros).
+    if code != kHighsStatusWarning {
+        ok(code, "bulk CSR import")?;
+    }
+    // A future option/backend change must not silently remove supported data.
+    let expected = a.values.iter().filter(|&&v| v != 0.0).count();
+    // SAFETY: read-only query of the same live handle; no buffers are retained.
+    let imported = unsafe { Highs_getNumNz(native.as_ptr()) };
+    if usize::try_from(imported).ok() != Some(expected) {
+        return Err(Error::Backend(format!(
+            "bulk CSR import retained {imported} nonzeros, expected {expected}"
+        )));
+    }
+    Ok(())
 }
