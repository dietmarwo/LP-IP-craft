+"""Reproducible adapter benchmarks; setup fixtures are not GTOC applications.
+
+python examples/benchmark_efficiency.py --repeats 5 > efficiency.json
+Run the same script against each installed wheel. No timing threshold is asserted.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import platform
+import statistics
+import subprocess
+import sys
+import time
+
+import lp_ip_craft as lp
+
+
+def cases():
+    # Analytic optimum at the variable lower bounds. These two intentionally
+    # expose import/check overhead rather than hard optimization search.
+    n = 100_000
+    yield "box-lp", dict(objective=[1.] * n, lower=[0.] * n, upper=[1.] * n,
+                         row_lower=[], row_upper=[], indptr=[0], indices=[], values=[]), 0.0
+    n, width = 40_000, 5
+    indices = [j for i in range(n) for j in sorted((i + k * 7919) % n for k in range(width))]
+    yield "sparse-import-lp", dict(objective=[1.] * n, lower=[0.] * n, upper=[1.] * n,
+        row_lower=[-float('inf')] * n, row_upper=[3.] * n,
+        indptr=list(range(0, n * width + 1, width)), indices=indices, values=[1.] * (n * width)), 0.0
+    origins, destinations = 60, 80
+    n = origins * destinations
+    rows = [list(range(i * destinations, (i + 1) * destinations)) for i in range(origins)]
+    rows += [list(range(j, n, destinations)) for j in range(destinations)]
+    indptr = [0]
+    for row in rows:
+        indptr.append(indptr[-1] + len(row))
+    rhs = [float(destinations)] * origins + [float(origins)] * destinations
+    yield "transport-lp", dict(objective=[1. + (j * 37 + j // destinations * 11) % 101 for j in range(n)],
+        lower=[0.] * n, upper=[float('inf')] * n, row_lower=rhs, row_upper=rhs,
+        indptr=indptr, indices=[j for row in rows for j in row], values=[1.] * (2 * n)), None
+    groups, width = 2000, 6
+    costs = [float(1 + (i * 37 + j * 13) % 97) for i in range(groups) for j in range(width)]
+    n = groups * width
+    yield "partition-mip", dict(objective=costs, objective_offset=7.,
+        lower=[0.] * n, upper=[1.] * n, kinds=['binary'] * n,
+        row_lower=[1.] * groups, row_upper=[1.] * groups,
+        indptr=list(range(0, n + 1, width)), indices=list(range(n)), values=[1.] * n), \
+        7. + sum(min(costs[i:i+width]) for i in range(0, n, width))
+
+
+def run_case(name, data, reference, repeats):
+    began = time.perf_counter()
+    model = lp.Model(**data)
+    construction = time.perf_counter() - began
+    runs = []
+    for k in range(repeats + 1):
+        began = time.perf_counter()
+        r = lp.solve(model, backend='highs')
+        wall = time.perf_counter() - began
+        assert r.status == 'optimal', r.message
+        assert r.evaluation is not None and r.evaluation.feasible_candidate
+        objective = r.evaluation.objective
+        if reference is not None:
+            assert abs(objective - reference) <= 1e-7 * (1 + abs(reference))
+        residuals = None
+        if r.duals is not None:
+            check = lp.lp_residuals(model, r.candidate, r.duals)
+            residuals = vars(check)
+            assert check.primal <= 1e-7
+            assert check.stationarity <= 1e-7 * (1 + max(map(abs, data['objective'])))
+            assert check.dual_sign <= 1e-7 * (1 + max(map(abs, data['objective'])))
+            assert check.duality_gap <= 1e-7
+        if k:
+            runs.append(dict(wall_seconds=wall, **{key: getattr(r.backend, key) for key in
+                ('total_seconds', 'conversion_seconds', 'solve_seconds', 'check_seconds')},
+                objective=objective, status=r.status, iterations=r.iterations, nodes=r.nodes,
+                best_bound=r.best_bound, residuals=residuals))
+    keys = ('wall_seconds', 'total_seconds', 'conversion_seconds', 'solve_seconds', 'check_seconds')
+    return dict(case=name, n=len(data['objective']), m=len(data['row_lower']), nnz=len(data['values']),
+                model_construction_seconds=construction, reference_objective=reference,
+                median={key: statistics.median(r[key] for r in runs) for key in keys}, runs=runs)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument('--repeats', type=int, default=5)
+    parser.add_argument('--case', action='append', help='Only this case (repeatable)')
+    parser.add_argument('--baseline-python', help='Python executable with the baseline wheel installed; compare in alternating process order')
+    args = parser.parse_args()
+    if args.repeats < 1:
+        parser.error('--repeats must be positive')
+    selected = [(name, data, ref) for name, data, ref in cases() if not args.case or name in args.case]
+    if not selected:
+        parser.error('no matching cases')
+    if args.baseline_python:
+        result = compare(args.baseline_python, [name for name, _, _ in selected], args.repeats)
+    else:
+        result = dict(version=lp.__version__, python=platform.python_version(), platform=platform.platform(),
+                      repeats=args.repeats, warmups=1,
+                      cases=[run_case(name, data, ref, args.repeats) for name, data, ref in selected])
+    result['benchmark_sha256'] = hashlib.sha256(Path(__file__).read_bytes()).hexdigest()
+    print(json.dumps(result, indent=2, allow_nan=False))
+
+
+def compare(baseline_python, names, repeats):
+    """Each child warms once and measures once. Wall time excludes process launch."""
+    # Preserve the virtual-environment executable path, including its symlink.
+    executables = {'baseline': str(Path(baseline_python).absolute()), 'new': sys.executable}
+    all_runs, summaries = [], []
+    metadata = {}
+    for name in names:
+        for rep in range(repeats):
+            for label in (('baseline', 'new') if rep % 2 == 0 else ('new', 'baseline')):
+                child = subprocess.run([executables[label], str(Path(__file__).resolve()),
+                                        '--case', name, '--repeats', '1'],
+                                       check=True, capture_output=True, text=True)
+                result = json.loads(child.stdout)
+                metadata[label] = {k: result[k] for k in ('version', 'python', 'platform')}
+                case = result['cases'][0]
+                all_runs.append(dict(label=label, repeat=rep, **case))
+        groups = {label: [r['runs'][0] for r in all_runs if r['case'] == name and r['label'] == label]
+                  for label in executables}
+        first = groups['baseline'][0]
+        for rows in groups.values():
+            for row in rows:
+                if abs(row['objective'] - first['objective']) > 1e-7 * (1 + abs(first['objective'])):
+                    raise RuntimeError(f'objective mismatch for {name}')
+        keys = ('wall_seconds', 'total_seconds', 'conversion_seconds', 'solve_seconds', 'check_seconds')
+        summary = {label: {key: statistics.median(r[key] for r in rows) for key in keys}
+                   for label, rows in groups.items()}
+        summaries.append(dict(case=name, median=summary,
+            wall_range={label: [min(r['wall_seconds'] for r in rows), max(r['wall_seconds'] for r in rows)]
+                        for label, rows in groups.items()},
+            ratios={key: summary['baseline'][key] / summary['new'][key] for key in keys}))
+    return dict(repeats=repeats, warmups_per_process=1, order='alternating baseline/new',
+                metadata=metadata, summary=summaries, runs=all_runs)
+
+
+if __name__ == '__main__':
+    main()
