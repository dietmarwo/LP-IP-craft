@@ -0,0 +1,113 @@
+//! Import regressions: analytic optima are checked in original coordinates.
+use lp_ip_craft::{
+    Bounds, CancellationToken, CsrMatrix, LpIpSolver, Model, ModelData, Options, Sense, Status,
+    VariableKind, check,
+};
+use lp_ip_craft_highs::HighsSolver;
+
+#[test]
+fn supported_small_coefficients_survive_import_in_lp_and_mip() {
+    let a = 2_f64.powi(-32); // 1e-12 < a < HiGHS's default drop threshold 1e-9.
+    let rhs = 2_f64.powi(-12);
+    let optimum = 2_f64.powi(20);
+    for sense in [Sense::Minimize, Sense::Maximize] {
+        for kind in [VariableKind::Continuous, VariableKind::Integer] {
+            let rows = match sense {
+                Sense::Minimize => Bounds::new(vec![rhs], vec![f64::INFINITY]),
+                Sense::Maximize => Bounds::new(vec![f64::NEG_INFINITY], vec![rhs]),
+            };
+            let model = Model::new(ModelData {
+                sense,
+                objective: vec![1.0],
+                objective_offset: 7.0,
+                variables: Bounds::new(vec![0.0], vec![2.0 * optimum]),
+                kinds: vec![kind],
+                matrix: CsrMatrix::new(1, 1, vec![0, 1], vec![0], vec![a]),
+                rows,
+            })
+            .unwrap();
+            let result = HighsSolver::default()
+                .solve(
+                    &model,
+                    &Options::default(),
+                    None,
+                    &CancellationToken::default(),
+                )
+                .unwrap();
+            assert_eq!(
+                result.status,
+                Status::Optimal,
+                "{sense:?} {kind:?}: {}",
+                result.message
+            );
+            assert_eq!(result.candidate.as_ref().unwrap(), &[optimum]);
+            assert_eq!(result.evaluation.as_ref().unwrap().objective, optimum + 7.0);
+            if let Some(duals) = &result.duals {
+                let residual =
+                    check::lp_residuals(&model, result.candidate.as_ref().unwrap(), duals).unwrap();
+                assert!(residual.max() <= 1e-7, "{residual:?}");
+            } else {
+                assert_eq!(result.best_bound, Some(optimum + 7.0));
+            }
+        }
+    }
+}
+
+#[test]
+fn sparse_import_handles_zeros_empty_free_ranged_and_fixed_entries() {
+    for sense in [Sense::Minimize, Sense::Maximize] {
+        for kind in [VariableKind::Continuous, VariableKind::Binary] {
+            let model = Model::new(ModelData {
+                sense,
+                objective: vec![2.0, 3.0, 5.0, 0.0],
+                objective_offset: 7.0,
+                variables: Bounds::new(
+                    vec![0.0, 0.0, 2.0, f64::NEG_INFINITY],
+                    vec![3.0, 1.0, 2.0, f64::INFINITY],
+                ),
+                kinds: vec![
+                    VariableKind::Continuous,
+                    kind,
+                    VariableKind::Continuous,
+                    VariableKind::Continuous,
+                ],
+                matrix: CsrMatrix::new(
+                    4,
+                    4,
+                    vec![0, 0, 3, 4, 5],
+                    vec![0, 1, 2, 3, 2],
+                    vec![1.0, 2.0, -0.0, 3.0, 1.0],
+                ),
+                rows: Bounds::new(
+                    vec![0.0, 2.5, f64::NEG_INFINITY, 1.0],
+                    vec![0.0, f64::INFINITY, f64::INFINITY, 3.0],
+                ),
+            })
+            .unwrap();
+            let original = model.clone();
+            let result = HighsSolver::default()
+                .solve(
+                    &model,
+                    &Options::default(),
+                    None,
+                    &CancellationToken::default(),
+                )
+                .unwrap();
+            assert_eq!(model, original); // Import never mutates the validated input.
+            assert_eq!(result.status, Status::Optimal, "{}", result.message);
+            let reference = if sense == Sense::Minimize { 21.0 } else { 26.0 };
+            assert_eq!(result.evaluation.as_ref().unwrap().objective, reference);
+            assert!(result.evaluation.as_ref().unwrap().feasible_candidate);
+            if let Some(duals) = &result.duals {
+                assert!(
+                    check::lp_residuals(&model, result.candidate.as_ref().unwrap(), duals)
+                        .unwrap()
+                        .max()
+                        <= 1e-7
+                );
+            } else {
+                assert_eq!(result.best_bound, Some(reference));
+            }
+        }
+    }
+}
