@@ -0,0 +1,45 @@
+"""Bulk-import behavior at the compiled Python boundary."""
+import math
+
+import pytest
+
+from lp_ip_craft import BACKENDS, Model, lp_residuals, solve
+
+pytestmark = pytest.mark.skipif('highs' not in BACKENDS, reason='built without HiGHS')
+
+
+@pytest.mark.parametrize('sense', ['minimize', 'maximize'])
+@pytest.mark.parametrize('kind', ['continuous', 'integer'])
+def test_supported_small_matrix_entry_is_not_dropped(sense, kind):
+    rhs, optimum = 2.**-12, 2.**20
+    model = Model(objective=[1.], objective_offset=7., sense=sense,
+        lower=[0.], upper=[2*optimum], kinds=[kind], indptr=[0, 1], indices=[0], values=[2.**-32],
+        row_lower=[rhs if sense == 'minimize' else -math.inf],
+        row_upper=[rhs if sense == 'maximize' else math.inf])
+    r = solve(model, backend='highs')
+    assert r.status == 'optimal', r.message
+    assert r.candidate == [optimum]
+    assert r.evaluation.objective == optimum + 7.
+    if r.duals is not None:
+        assert max(vars(lp_residuals(model, r.candidate, r.duals)).values()) <= 1e-7
+    else:
+        assert r.best_bound == optimum + 7.
+
+
+@pytest.mark.parametrize('coefficient', [1e-12, -1e-12, 1e-13])
+def test_unsupported_matrix_entries_remain_explicit_errors(coefficient):
+    model = Model(objective=[1.], lower=[0.], upper=[1.], indptr=[0, 1],
+                  indices=[0], values=[coefficient], row_lower=[-1.], row_upper=[1.])
+    with pytest.raises(NotImplementedError, match='matrix value'):
+        solve(model, backend='highs')
+
+
+def test_empty_rows_and_only_explicit_zeros():
+    # nnz > 0 at the interface, but all entries legitimately vanish on import.
+    model = Model(objective=[1., -1.], lower=[0., 0.], upper=[1., 1.],
+                  indptr=[0, 0, 2], indices=[0, 1], values=[0., -0.],
+                  row_lower=[0., -math.inf], row_upper=[0., math.inf])
+    r = solve(model, backend='highs')
+    assert r.status == 'optimal' and r.candidate == [0., 1.]
+    assert r.evaluation.row_activity == [0., 0.]
+    assert r.evaluation.objective == -1.
